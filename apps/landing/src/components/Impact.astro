<section id="impact" class="py-20 bg-base-200">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <div class="badge badge-outline badge-lg mb-4" data-aos="fade-down">
        IMPACTO
      </div>
      <h2
        class="text-4xl md:text-5xl font-bold mb-4 font-lexend"
        data-aos="fade-up"
      >
        <span class="text-gradient">Resultados Medibles</span>
      </h2>
      <p
        class="text-xl text-base-content/70 max-w-3xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        Datos verificados de nuestra comunidad global
      </p>
    </div>

    <!-- Progress cards -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      <div class="card bg-base-100 shadow-xl hover-lift" data-aos="flip-left">
        <div class="card-body items-center text-center">
          <div
            class="radial-progress text-primary text-4xl font-bold animate-pulse-glow"
            style="--value:87"
          >
            87%
          </div>
          <h3 class="card-title">Mejora en Lectura</h3>
          <p class="text-sm text-base-content/60">En 3 meses de uso</p>
        </div>
      </div>

      <div
        class="card bg-base-100 shadow-xl hover-lift"
        data-aos="flip-left"
        data-aos-delay="100"
      >
        <div class="card-body items-center text-center">
          <div
            class="radial-progress text-secondary text-4xl font-bold animate-pulse-glow"
            style="--value:92"
          >
            92%
          </div>
          <h3 class="card-title">Retención</h3>
          <p class="text-sm text-base-content/60">De usuarios activos</p>
        </div>
      </div>

      <div
        class="card bg-base-100 shadow-xl hover-lift"
        data-aos="flip-left"
        data-aos-delay="200"
      >
        <div class="card-body items-center text-center">
          <div
            class="radial-progress text-accent text-4xl font-bold animate-pulse-glow"
            style="--value:95"
          >
            95%
          </div>
          <h3 class="card-title">Satisfacción</h3>
          <p class="text-sm text-base-content/60">Calificación padres</p>
        </div>
      </div>

      <div
        class="card bg-base-100 shadow-xl hover-lift"
        data-aos="flip-left"
        data-aos-delay="300"
      >
        <div class="card-body items-center text-center">
          <div
            class="radial-progress text-info text-4xl font-bold animate-pulse-glow"
            style="--value:78"
          >
            78%
          </div>
          <h3 class="card-title">Diagnóstico Temprano</h3>
          <p class="text-sm text-base-content/60">Casos detectados</p>
        </div>
      </div>
    </div>

    <!-- Timeline de logros -->
    <div class="max-w-4xl mx-auto">
      <ul
        class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical"
      >
        <li data-aos="fade-right">
          <div class="timeline-middle">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-5 w-5 text-primary"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
          <div class="timeline-start md:text-end mb-10">
            <time class="font-mono italic">2023</time>
            <div class="text-lg font-black">100K usuarios</div>
            Lanzamiento en España y Latinoamérica
          </div>
          <hr class="bg-primary" />
        </li>
        <li data-aos="fade-left">
          <hr class="bg-primary" />
          <div class="timeline-middle">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-5 w-5 text-secondary"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
          <div class="timeline-end mb-10">
            <time class="font-mono italic">2024</time>
            <div class="text-lg font-black">300K usuarios</div>
            Validación científica y premios internacionales
          </div>
          <hr class="bg-secondary" />
        </li>
        <li data-aos="fade-right">
          <hr class="bg-secondary" />
          <div class="timeline-middle">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-5 w-5 text-accent"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
          <div class="timeline-start md:text-end mb-10">
            <time class="font-mono italic">2025</time>
            <div class="text-lg font-black">500K+ usuarios</div>
            Expansión global y IA avanzada
          </div>
          <hr class="bg-accent" />
        </li>
      </ul>
    </div>
  </div>
</section>
