---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Games from "../components/Games.astro";
import Impact from "../components/Impact.astro";
import Testimonials from "../components/Testimonials.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
import Temas from "../components/Temas.astro";
import ScrollToTop from "../components/ScrollToTop.astro";

import "../styles/global.css";
import "../styles/cognitive.css";
---

<Layout
  title="Cognitive PlayKit - Transformando el Aprendizaje para Niños con Dislexia"
>
  <!-- Sección principal / portada -->
  <Hero />

  <!-- Características principales -->
  <Features />

  <!-- Qué hace la plataforma -->
  <Temas />

  <!-- Juegos y actividades -->
  <Games />

  <!-- Impacto y beneficios -->
  <Impact />

  <!-- Opiniones de usuarios -->
  <Testimonials />

  <!-- Llamado a la acción -->
  <Cta />

  <!-- Footer -->
  <Footer />

  <!-- Botón de scroll to top -->
  <ScrollToTop client:load />
</Layout>
